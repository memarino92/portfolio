---
import "../styles/prose.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
---
<BaseLayout title="Speaking" description="Sharing ideas about .NET, TypeScript, and the web at local meetups.">
  <div class="wrap">
    <PageHeader eyebrow="Sharing what I learn" title="Speaking" lede="I enjoy talking through ideas with other developers, especially at local meetups." />
    <div class="prose section">
      <p>I’ve shared what I’ve learned with the communities at <a href="https://www.meetup.com/rva-js/">RVA.js</a> and <a href="https://rvasdug.org/">RVASDUG</a>.</p>
      <p>If you’d like to talk about .NET, TypeScript, or modern web APIs at your event, <a href="mailto:michael@michaelmarino.dev">get in touch</a>.</p>
    </div>
  </div>
</BaseLayout>
